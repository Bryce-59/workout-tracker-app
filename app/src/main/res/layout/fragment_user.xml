<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E4E4E4"
    tools:context=".ui.user.UserFragment"
    android:orientation="vertical">



    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardPreventCornerOverlap="true"
        app:cardUseCompatPadding="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/body_measurement_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp">

            <TextView
                android:id="@+id/body_measurement_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Body Measurements"
                android:textColor="#9C27B0"
                android:textSize="30sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/edit_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/icons8_pencil_50"
                app:layout_constraintBottom_toBottomOf="@+id/body_measurement_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/body_measurement_label" />

            <ImageView
                android:id="@+id/weight_image"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:src="@drawable/icons8_weight_64"
                android:layout_marginTop="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/body_measurement_label"/>

            <TextView
                android:id="@+id/weight_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginStart="5dp"
                android:text="Weight"
                android:textSize="20sp"
                app:layout_constraintStart_toEndOf="@id/weight_image"
                app:layout_constraintTop_toBottomOf="@+id/body_measurement_label" />

            <TextView
                android:id="@+id/weight_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Enter your weight"
                android:textSize="20sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/body_measurement_label" />

            <ImageView
                android:id="@+id/height_image"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:src="@drawable/icons8_ruler_64"
                android:layout_marginTop="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/weight_label"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginStart="5dp"
                android:text="Height"
                android:textSize="20sp"
                app:layout_constraintStart_toEndOf="@id/height_image"
                app:layout_constraintTop_toBottomOf="@+id/weight_label" />

            <TextView
                android:id="@+id/height_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Enter your height"
                android:textSize="20sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/weight_label" />

            <ImageView
                android:id="@+id/bmi_image"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/icons8_folder_64"
                app:layout_constraintTop_toBottomOf="@id/height_image"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginStart="5dp"
                android:text="BMI"
                android:textSize="20sp"
                app:layout_constraintStart_toEndOf="@id/bmi_image"
                app:layout_constraintTop_toBottomOf="@id/height_image" />

            <TextView
                android:id="@+id/bmi_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:layout_marginTop="10dp"
                android:text="Unavailable"
                app:layout_constraintTop_toBottomOf="@id/height_image"
                app:layout_constraintEnd_toEndOf="parent"
                />

            <TextView
                android:id="@+id/last_update_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/last_update"
                app:layout_constraintTop_toBottomOf="@id/bmi_image"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardPreventCornerOverlap="true"
        app:cardUseCompatPadding="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp">

            <TextView
                android:id="@+id/activity_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Activities Today"
                android:textColor="#9C27B0"
                android:textSize="30sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/time_image"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/icons8_clock_64"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/activity_label"/>

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginStart="5dp"
                android:text="Workout Time"
                android:textSize="20sp"
                app:layout_constraintStart_toEndOf="@id/time_image"
                app:layout_constraintTop_toBottomOf="@id/activity_label"/>

            <TextView
                android:id="@+id/workout_time_text"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:layout_marginTop="10dp"
                android:text="--:--"
                android:textSize="20sp"
                app:layout_constraintTop_toBottomOf="@id/activity_label"
                app:layout_constraintEnd_toEndOf="parent"/>

            <ImageView
                android:id="@+id/run_image"
                android:layout_height="27dp"
                android:layout_width="27dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/icons8_running_64__1_"
                app:layout_constraintTop_toBottomOf="@id/time_image"
                app:layout_constraintStart_toStartOf="parent"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:text="Running Time"
                android:layout_marginTop="10dp"
                android:layout_marginStart="5dp"
                app:layout_constraintTop_toBottomOf="@id/time_image"
                app:layout_constraintStart_toEndOf="@id/run_image"/>

            <TextView
                android:id="@+id/running_time_text"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:layout_marginTop="10dp"
                android:text="--:--"
                android:textSize="20sp"
                app:layout_constraintTop_toBottomOf="@id/time_image"
                app:layout_constraintEnd_toEndOf="parent"/>

            <ImageView
                android:id="@+id/calories_image"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:src="@drawable/icons8_fire_64"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@id/run_image"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginStart="5dp"
                android:text="Calories Burnt"
                android:textSize="20dp"
                app:layout_constraintTop_toBottomOf="@id/run_image"
                app:layout_constraintStart_toEndOf="@id/calories_image"/>

            <TextView
                android:id="@+id/calories_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="20dp"
                android:text="0 kcal"
                app:layout_constraintTop_toBottomOf="@id/run_image"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>