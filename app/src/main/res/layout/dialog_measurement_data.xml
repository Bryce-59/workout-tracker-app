<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/dialog_label"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:text="Please enter your body measurements"
        android:textSize="20dp"
        android:textAlignment="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <EditText
        android:id="@+id/user_weight"
        android:inputType="numberDecimal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:layout_marginBottom="4dp"
        android:hint="Enter your weight"
        app:layout_constraintTop_toBottomOf="@id/dialog_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="lbs"
        android:textSize="24sp"
        app:layout_constraintStart_toEndOf="@+id/user_weight"
        app:layout_constraintTop_toBottomOf="@id/dialog_label" />

    <EditText
        android:id="@+id/user_height_ft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="4dp"
        android:fontFamily="sans-serif"
        android:hint="Enter ft"
        android:inputType="number"
        app:layout_constraintEnd_toStartOf="@id/user_height_inch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/user_weight"
        app:layout_constraintHorizontal_chainStyle="packed"/>

    <TextView
        android:id="@+id/ft_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="ft"
        android:textSize="24sp"
        app:layout_constraintStart_toEndOf="@+id/user_height_ft"
        app:layout_constraintTop_toBottomOf="@id/user_weight" />

    <EditText
        android:id="@+id/user_height_inch"
        android:inputType="number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:layout_marginBottom="16dp"
        android:fontFamily="sans-serif"
        android:hint="Enter inch"
        app:layout_constraintTop_toBottomOf="@+id/user_weight"
        app:layout_constraintStart_toStartOf="@id/ft_label"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/inch_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="inch"
        android:textSize="24sp"
        app:layout_constraintStart_toEndOf="@+id/user_height_inch"
        app:layout_constraintTop_toBottomOf="@id/user_weight" />


</androidx.constraintlayout.widget.ConstraintLayout>